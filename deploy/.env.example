# 部署环境变量模板：复制为 .env（或注入 systemd EnvironmentFile）后按需填写
# 生产环境缺少 DJANGO_SECRET_KEY 会直接启动失败；其余缺失时按默认值/空值运行

# ---------- Django 基础 ----------
# 生产必填：随机长字符串（如 `python -c "import secrets; print(secrets.token_urlsafe(50))"`）
DJANGO_SECRET_KEY=

# 允许的域名/主机，逗号分隔（默认 www.xuzixuan.top,10.83.36.241,100.93.171.11,localhost）
# DJANGO_ALLOWED_HOSTS=www.xuzixuan.top,localhost

# ---------- 邮件（SMTP）----------
# 示例 163 邮箱：smtp.163.com 端口 465 SSL
# EMAIL_HOST_USER 为发件邮箱地址，EMAIL_HOST_PASSWORD 为邮箱的 SMTP 授权码（非登录密码）
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------- HTTPS（可选，公网 HTTPS 就绪后开启）----------
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_COOKIES=false
